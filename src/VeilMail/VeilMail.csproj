<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VeilMail</RootNamespace>
    <PackageId>VeilMail</PackageId>
    <Version>0.1.0</Version>
    <Authors>Resonia Health</Authors>
    <Company>Resonia Health</Company>
    <Description>Official .NET SDK for Veil Mail — secure transactional and marketing email with automatic PII protection. A drop-in alternative to Resend, SendGrid, Mailgun, and Postmark for .NET and ASP.NET Core.</Description>
    <PackageDescription>Official .NET SDK for Veil Mail — secure transactional and marketing email with automatic PII protection. A drop-in alternative to Resend, SendGrid, Mailgun, and Postmark. Full support for emails, domains, templates, audiences, campaigns, automation sequences, webhooks, and CASL compliance.</PackageDescription>
    <PackageTags>email;email-api;transactional-email;marketing-email;sdk;veilmail;resend;resend-alternative;sendgrid;sendgrid-alternative;mailgun;mailgun-alternative;postmark;postmark-alternative;pii;pii-protection;casl;gdpr;compliance;smtp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://veilmail.xyz/docs/sdk-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Resonia-Health/veilmail-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.0" />
  </ItemGroup>

</Project>
